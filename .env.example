# Copy to .env and fill in. .env is gitignored; never commit real secrets.

APP_ENV=development
LOG_LEVEL=INFO

# Postgres. docker-compose.yml uses these to initialise the container; the app uses them to connect.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=courier
POSTGRES_PASSWORD=change-me-local-dev
POSTGRES_DB=courier_ops

# LLM provider: not chosen yet; settings arrive with the Text-to-SQL and triage phases.
