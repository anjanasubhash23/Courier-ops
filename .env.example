# Copy to .env and fill in. .env is gitignored; never commit real secrets.

APP_ENV=development
LOG_LEVEL=INFO

# Postgres. docker-compose.yml uses these to initialise the container; the app uses them to connect.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=courier
POSTGRES_PASSWORD=change-me-local-dev
POSTGRES_DB=courier_ops

# Login tokens. Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
TOKEN_MINUTES=480

# LLM for Text-to-SQL ("ask") and triage. Leave as "none" to run without one: asking is then unavailable
# and triage uses its rule-based diagnosis. Options:
#   ollama     local and free: `brew install ollama && ollama pull qwen2.5-coder:7b`, then LLM_MODEL=qwen2.5-coder:7b
#   openai     api.openai.com (needs LLM_API_KEY), or any OpenAI-compatible server via LLM_BASE_URL
#   anthropic  e.g. LLM_MODEL=claude-opus-5-5; key from LLM_API_KEY, ANTHROPIC_API_KEY or `ant auth login`
LLM_PROVIDER=none
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120
